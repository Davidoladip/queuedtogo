{
  "name": "queuedtogo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:db": "./scripts/test-db.sh",
    "test:smoke": "python3 tests/e2e/smoke.py",
    "test:prototype": "python3 prototype/tests/test_design.py",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:types:local": "supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public > src/types/database.ts",
    "test:unit": "vitest run",
    "test:builder": "python3 tests/e2e/builder.py && python3 tests/e2e/customize.py && python3 tests/e2e/orders.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  }
}
